cabal-version: 2.4
name: pmt-pandoc-server
version: 0.1.0.0
build-type: Simple
license: GPL-2.0-or-later
synopsis: Shared Pandoc CLI and worker for Papper
description: Pandoc-compatible CLI and long-lived worker for Papper's HTML service.
extra-source-files: vendor/pandoc/COPYING.md, vendor/pandoc/COPYRIGHT

executable pmt-pandoc-worker
  main-is: Main.hs
  hs-source-dirs: ., vendor/pandoc-cli
  other-modules: Papper.Citeproc, Papper.Locator, PandocCLI.Lua, PandocCLI.Server
  default-language: Haskell2010
  cpp-options: -DREPL
  ghc-options: -O2 -threaded -rtsopts -with-rtsopts=-A16m
  build-depends:
      base >= 4.22 && < 4.23
    , pandoc >= 3.12 && < 3.13
    , pandoc-lua-engine >= 0.5.4.1 && < 0.6
    , pandoc-server >= 0.1.4.1 && < 0.2
    , wai-extra >= 3.1.18 && < 3.2
    , warp >= 3.4.16 && < 3.5
    , hslua-cli >= 1.4.4 && < 1.5
    , temporary >= 1.3 && < 1.4
    , pandoc-crossref == 0.3.25
    , pandoc-types >= 1.23.1.2 && < 1.24
    , deepseq >= 1.5.2.0 && < 1.6
    , citeproc >= 0.14 && < 0.15
    , containers >= 0.8 && < 0.9
    , data-default >= 0.8.0.2 && < 0.9
    , mtl >= 2.3.2 && < 2.4
    , safe >= 0.3.21 && < 0.4
    , aeson >= 2.3.2.0 && < 2.4
    , bytestring >= 0.12.2.0 && < 0.13
    , directory >= 1.3.11.0 && < 1.4
    , filepath >= 1.5.5.0 && < 1.6
    , time >= 1.16.0.1 && < 1.17
    , text >= 2.1.4 && < 2.2

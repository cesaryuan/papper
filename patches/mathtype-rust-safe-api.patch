+/// Owned Word equation artifacts without a preview or serialized FFI envelope.
+#[derive(Debug)]
+pub struct EquationPayload {
+    /// Normalized TeX source retained in the MTEF source record.
+    pub normalized_latex: String,
+    /// MathType's binary equation representation for SDK consumers.
+    pub mtef: Vec<u8>,
+    /// Complete compound OLE object ready to embed in a Word document.
+    pub ole: Vec<u8>,
+}
+
+/// Select source recovery or structural interpretation when importing equations.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub enum DecodeMode {
+    /// Recover source first and use structural interpretation if source is absent.
+    #[default]
+    Auto,
+    /// Require MathType's embedded TeX-source record.
+    Source,
+    /// Interpret MTEF structure without consulting the source record.
+    Structural,
+}
+
+/// Encode a Word equation with optional preferences, preserving its three-stream OLE layout.
+pub fn encode_latex(
+    latex: &str,
+    preferences: Option<&std::path::Path>,
+) -> Result<EquationPayload, String> {
+    let equation = conversion::latex_to_equation(latex, preferences, false, false)?;
+    Ok(EquationPayload {
+        normalized_latex: equation.normalized_latex,
+        mtef: equation.mtef,
+        ole: equation.ole,
+    })
+}
+
+/// Extract validated MTEF from an existing OLE artifact without re-encoding its TeX source.
+pub fn mtef_from_ole(ole: &[u8]) -> Result<Vec<u8>, String> {
+    conversion::extract_mtef_from_ole(ole)
+}
+
+/// Decode an OLE equation through the same source/structural paths used by the CLI and C ABI.
+pub fn decode_ole(ole: &[u8], mode: DecodeMode) -> Result<String, String> {
+    let mtef = mtef_from_ole(ole)?;
+    match mode {
+        DecodeMode::Auto => conversion::mtef_to_latex(&mtef)
+            .or_else(|_| conversion::mtef_to_latex_structural(&mtef)),
+        DecodeMode::Source => conversion::mtef_to_latex(&mtef),
+        DecodeMode::Structural => conversion::mtef_to_latex_structural(&mtef),
+    }
+}

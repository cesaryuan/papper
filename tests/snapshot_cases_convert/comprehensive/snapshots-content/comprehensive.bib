@article{longRegionawareNeuralRadiance2026,
  author = {Long, Feiyuan and Bao, Yuequan and Hou, Rongrong},
  title = {Region-Aware Neural Radiance Fields for Three-Dimensional
    Building Reconstruction and Facade Detail Preservation},
  journal = {Developments in the Built Environment},
  volume = {27},
  pages = {101019},
  date = {2026-10-01},
  doi = {10.1016/j.dibe.2026.101019},
  issn = {2666-1659},
  langid = {en},
  abstract = {High-fidelity textured three-dimensional (3D) building
    meshes are essential for digital twins, facade inspection, and
    condition assessment, but reconstructing fine details such as cracks
    remains challenging. This paper proposes a region-aware Neural
    Radiance Field (NeRF) method for reconstructing building meshes. Key
    innovations include: (1) A region-aware adaptive sampling algorithm
    that increases sampling density in complex texture areas using a 3D
    spatial attention field; (2) A decoupled pipeline separating mesh
    extraction from texture synthesis via learned signed distance
    fields; and (3) region-guided mesh refinement that enhances
    geometric detail in critical facade areas. Experiments on
    UAV-captured building data show better mesh regularity and texture
    clarity than representative photogrammetric and neural baselines.
    ROI-based metrics and local geometric-detail indicators provide
    complementary evidence of improved reconstruction in fine-textured
    regions. The workflow yields an explicit textured mesh without dense
    point-cloud meshing after camera pose estimation, supporting offline
    digital documentation for inspection-oriented building models.}
}

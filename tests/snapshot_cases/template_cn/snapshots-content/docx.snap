      "<dcterms:modified xsi:type=\"dcterms:W3CDTF\">&lt;normalized&gt;</dcterms:modified>",
      "</cp:coreProperties>"
    ]
  },
  "docProps/custom.xml": {
    "xml": [
      "<Properties xmlns=\"http://schemas.openxmlformats.org/officeDocument/2006/custom-properties\" xmlns:vt=\"http://schemas.openxmlformats.org/officeDocument/2006/docPropsVTypes\">",
      "<property fmtid=\"{D5CDD505-2E9C-101B-9397-08002B2CF9AE}\" name=\"abstract\" pid=\"2\">",
      "<vt:lpwstr>这是一个使用 Pandoc 编写学术论文的中文模板。请将本摘要替换为你自己的研究概述。摘要应简洁说明研究问题、研究方法、主要结果和结论。根据期刊要求，建议控制在 150—250 个英文单词或相应篇幅以内。本模板演示了图、表、引文、交叉引用以及 E=mc^2 等公式的 Pandoc Markdown 写法。</vt:lpwstr>",
      "</property>",
      "<property fmtid=\"{D5CDD505-2E9C-101B-9397-08002B2CF9AE}\" name=\"authors\" pid=\"3\">",
      "<vt:lpwstr>",
      "</vt:lpwstr>",

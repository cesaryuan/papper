      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">已有研究取得了一些有意义的结果</w:t>",
      "</w:r>",
      "<w:r>",
      "<w:rPr>",
      "<w:vertAlign w:val=\"superscript\">",

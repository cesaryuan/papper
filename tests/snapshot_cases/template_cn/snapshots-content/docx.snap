      "<w:bookmarkStart w:id=\"9\" w:name=\"_cebaa1f6ada0c89507e61caf930b3b1c7b5b035\">",
      "</w:bookmarkStart>",
      "<w:p>",
      "<w:pPr>",
      "<w:pStyle w:val=\"1\">",
      "</w:pStyle>",
      "</w:pPr>",
      "<w:r>",
      "<w:rPr>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">1 </w:t>",
      "</w:r>",
      "<w:r>",
      "<w:rPr>",
      "<w:rFonts w:hint=\"eastAsia\">",
      "</w:rFonts>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">引言</w:t>",
      "</w:r>",
      "</w:p>",
      "<w:p>",
      "<w:pPr>",
      "<w:pStyle w:val=\"FirstParagraph\">",
      "</w:pStyle>",
      "</w:pPr>",
      "<w:r>",
      "<w:rPr>",
      "<w:rFonts w:hint=\"eastAsia\">",
      "</w:rFonts>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">本模板展示了使用</w:t>",
      "</w:r>",
      "<w:r>",
      "<w:rPr>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\"> Pandoc Markdown </w:t>",
      "</w:r>",
      "<w:r>",
      "<w:rPr>",
      "<w:rFonts w:hint=\"eastAsia\">",
      "</w:rFonts>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">编写学术论文的基本结构和功能。请将这些示例内容替换为你自己的研究引言。</w:t>",
      "</w:r>",
      "</w:p>",
      "<w:p>",
      "<w:pPr>",
      "<w:pStyle w:val=\"a0\">",
      "</w:pStyle>",
      "</w:pPr>",
      "<w:r>",
      "<w:rPr>",
      "<w:rFonts w:hint=\"eastAsia\">",
      "</w:rFonts>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">引言应形成连贯的叙述，将读者从一般研究背景引导到具体研究问题。首先介绍更广泛的研究领域及其重要性，然后通过引用已有工作说明研究背景，例如引用单篇文献</w:t>",
      "</w:r>",
      "<w:r>",
      "<w:rPr>",
      "<w:vertAlign w:val=\"superscript\">",
      "</w:vertAlign>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">[</w:t>",
      "</w:r>",
      "<w:hyperlink w:anchor=\"_65cf582a4c1c30ac1c480b5590e1ff017567d15\">",
      "<w:r>",
      "<w:rPr>",
      "<w:rStyle w:val=\"af\">",
      "</w:rStyle>",
      "<w:vertAlign w:val=\"superscript\">",
      "</w:vertAlign>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">1</w:t>",
      "</w:r>",
      "</w:hyperlink>",
      "<w:r>",
      "<w:rPr>",
      "<w:vertAlign w:val=\"superscript\">",
      "</w:vertAlign>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">]</w:t>",
      "</w:r>",
      "<w:r>",
      "<w:rPr>",
      "<w:rFonts w:hint=\"eastAsia\">",
      "</w:rFonts>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">、同时引用多篇文献</w:t>",
      "</w:r>",
      "<w:r>",
      "<w:rPr>",
      "<w:vertAlign w:val=\"superscript\">",
      "</w:vertAlign>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">[</w:t>",
      "</w:r>",
      "<w:hyperlink w:anchor=\"_e7561e68abb779cbc866e3fa7fcef549a98554c\">",
      "<w:r>",
      "<w:rPr>",
      "<w:rStyle w:val=\"af\">",
      "</w:rStyle>",
      "<w:vertAlign w:val=\"superscript\">",
      "</w:vertAlign>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">2</w:t>",
      "</w:r>",
      "</w:hyperlink>",
      "<w:r>",
      "<w:rPr>",
      "<w:vertAlign w:val=\"superscript\">",
      "</w:vertAlign>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">–</w:t>",
      "</w:r>",
      "<w:hyperlink w:anchor=\"_d57507ecb02820041adf0700bf15236e04dcb82\">",
      "<w:r>",
      "<w:rPr>",
      "<w:rStyle w:val=\"af\">",
      "</w:rStyle>",

      "</w:rFonts>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">，或引用特定页码</w:t>",
      "</w:r>",
      "<w:r>",
      "<w:rPr>",
      "<w:vertAlign w:val=\"superscript\">",
      "</w:vertAlign>",
      "<w:lang w:val=\"zh-Hans\">",
      "</w:lang>",
      "</w:rPr>",

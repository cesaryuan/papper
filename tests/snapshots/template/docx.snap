      "<w:r>",
      "<w:t xml:space=\"preserve\"> </w:t>",
      "</w:r>",
      "<w:r>",
      "<w:t xml:space=\"preserve\">spans two rows,</w:t>",
      "</w:r>",
      "<w:r>",
      "<w:t xml:space=\"preserve\"> </w:t>",
      "</w:r>",
      "<w:r>",
      "<w:t xml:space=\"preserve\">“Group B”</w:t>",
      "</w:r>",
      "<w:r>",
      "<w:t xml:space=\"preserve\"> </w:t>",
      "</w:r>",
      "<w:r>",
      "<w:t xml:space=\"preserve\">spans two rows, and the last row has a merged cell spanning two columns.</w:t>",
      "</w:r>",

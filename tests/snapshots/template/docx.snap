      "</wp:effectExtent>",
      "<wp:docPr descr=\"Figure 1 A single-figure example showing a synthetic performance trend across evaluation steps.\" id=\"26\" name=\"Picture\" title=\"\">",
      "</wp:docPr>",
      "<a:graphic>",
      "<a:graphicData uri=\"http://schemas.openxmlformats.org/drawingml/2006/picture\">",

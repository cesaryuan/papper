      "<w:r>",
      "<w:t xml:space=\"preserve\"> </w:t>",
      "</w:r>",
      "<w:r>",
      "<w:t xml:space=\"preserve\">using Pandoc Markdown syntax.</w:t>",
      "</w:r>",

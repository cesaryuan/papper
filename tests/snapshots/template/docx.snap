      "<w:t xml:space=\"preserve\"> </w:t>",
      "</w:r>",
      "<w:r>",
      "<w:t xml:space=\"preserve\">is the per-sample loss,</w:t>",
      "</w:r>",
      "<w:r>",
      "<w:t xml:space=\"preserve\"> </w:t>",
      "</w:r>",
      "<m:oMath>",
      "<m:r>",

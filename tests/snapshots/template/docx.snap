      "</pic:cNvPr>",
      "<pic:cNvPicPr>",
      "<a:picLocks noChangeArrowheads=\"1\" noChangeAspect=\"1\">",
      "</a:picLocks>",
      "</pic:cNvPicPr>",
      "</pic:nvPicPr>",
      "<pic:blipFill>",

      "<w:p>",
      "<w:pPr>",
      "<w:pStyle w:val=\"ImageCaption\">",
      "</w:pStyle>",
      "</w:pPr>",
      "<w:r>",
      "<w:t xml:space=\"preserve\">Figure 1 A single-figure example showing a synthetic performance trend across evaluation steps.</w:t>",
      "</w:r>",
      "</w:p>",
      "<w:bookmarkEnd w:id=\"28\">",
      "</w:bookmarkEnd>",
      "<w:p>",
      "<w:pPr>",
      "<w:pStyle w:val=\"FirstParagraph\">",
      "</w:pStyle>",
      "</w:pPr>",
      "<w:r>",
      "<w:t xml:space=\"preserve\">For most multi-panel layouts, prepare one SVG file that references the child image files with relative paths. The SVG example in Figure </w:t>",
      "</w:r>",
      "<w:hyperlink w:anchor=\"_eeafbb93e6ee75088695c531f4346c4bb901e61\">",
      "<w:r>",
      "<w:rPr>",
      "<w:rStyle w:val=\"af\">",
      "</w:rStyle>",
      "</w:rPr>",
      "<w:t xml:space=\"preserve\">2</w:t>",
      "</w:r>",
      "</w:hyperlink>",
      "<w:r>",
      "<w:t xml:space=\"preserve\"> </w:t>",
      "</w:r>",
      "<w:r>",
      "<w:t xml:space=\"preserve\">composes two synthetic panels, while Markdown treats the result as one normal figure with one caption and one cross-reference label.</w:t>",
      "</w:r>",
      "</w:p>",
      "<w:bookmarkStart w:id=\"32\" w:name=\"_eeafbb93e6ee75088695c531f4346c4bb901e61\">",
      "</w:bookmarkStart>",
      "<w:p>",
      "<w:pPr>",
      "<w:pStyle w:val=\"CaptionedFigure\">",
      "</w:pStyle>",
      "</w:pPr>",
      "<w:r>",
      "<w:drawing>",
      "<wp:inline>",
      "<wp:extent cx=\"4743450\" cy=\"2254017\">",
      "</wp:extent>",
      "<wp:effectExtent b=\"0\" l=\"0\" r=\"0\" t=\"0\">",
      "</wp:effectExtent>",
      "<wp:docPr descr=\"Figure 2 An SVG-based multi-panel layout whose child panels are referenced by relative image paths inside the SVG file.\" id=\"30\" name=\"Picture\" title=\"\">",
      "</wp:docPr>",
      "<a:graphic>",
      "<a:graphicData uri=\"http://schemas.openxmlformats.org/drawingml/2006/picture\">",
      "<pic:pic>",
      "<pic:nvPicPr>",
      "<pic:cNvPr descr=\"__PAPPER_CACHE__/svg-png/subfigure-svg-layout-example-__SOURCE_PATH_HASH__.png\" id=\"31\" name=\"Picture\">",
      "</pic:cNvPr>",
      "<pic:cNvPicPr>",
      "<a:picLocks noChangeArrowheads=\"1\" noChangeAspect=\"1\">",
      "</a:picLocks>",
      "</pic:cNvPicPr>",
      "</pic:nvPicPr>",
      "<pic:blipFill>",
      "<a:blip r:embed=\"rId29\">",
      "</a:blip>",
